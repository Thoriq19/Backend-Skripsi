{
	"info": {
		"_postman_id": "microservices-kos-collection",
		"name": "Microservices Kos - API Collection",
		"description": "Koleksi lengkap API untuk testing microservices manajemen kos.\n\n**Cara Pakai:**\n1. Import file ini ke Postman\n2. Jalankan semua service (`start-services.bat`)\n3. Jalankan request `Login sebagai Owner` terlebih dahulu\n4. Copy token dari response, paste ke variabel `token` di Collection Variables\n5. Semua request lainnya akan otomatis menggunakan token tersebut",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "gateway_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "🏥 Health Check",
			"item": [
				{
					"name": "Health Check - Semua Service",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gateway_url}}/api/health",
							"host": ["{{gateway_url}}"],
							"path": ["api", "health"]
						},
						"description": "Cek status kesehatan semua microservices."
					}
				}
			]
		},
		{
			"name": "🔐 Auth Service",
			"item": [
				{
					"name": "Register Owner",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nama_user\": \"Owner Kos Baru\",\n    \"email_user\": \"ownerbaru@example.com\",\n    \"password_user\": \"password123\",\n    \"password_user_confirmation\": \"password123\",\n    \"nohp_user\": \"081234567890\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/auth/register",
							"host": ["{{gateway_url}}"],
							"path": ["api", "auth", "register"]
						},
						"description": "Registrasi akun owner baru. Hanya role owner yang bisa didaftarkan melalui endpoint ini."
					}
				},
				{
					"name": "Login sebagai Owner",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"    console.log('Token saved automatically!');",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email_user\": \"owner@microservices.test\",\n    \"password_user\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/auth/login",
							"host": ["{{gateway_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login sebagai Owner. Token JWT otomatis disimpan ke variabel `token`."
					}
				},
